# A full Kuma system definition. Every field the schema accepts appears
# here; the commented ones are optional and show their default.
schema_version = 1

[system]
# Unset — the default — kuma composes its own base from Fedora's package
# repos: Fedora's minimal bootc core (kernel, systemd, bootc, dnf) plus
# hardware enablement, and none of the general-purpose weight
# fedora-bootc carries. Set it to any bootc image reference to build
# FROM that instead — the escape hatch for debugging against
# fedora-bootc, a mirror, or a test tag.
# base = "quay.io/fedora/fedora-bootc:44"

# The composed base ships every vendor's firmware by default, so any
# machine boots with working GPU/wifi/audio. Name packages here to trim
# the base to exactly your hardware (see `kuma schema` for the set).
# firmware = ["amd-gpu-firmware", "amd-ucode-firmware", "mt7xxx-firmware"]

# A curated set kuma maintains, not a package list you assemble.
# "niri" (scrollable tiling) or "cosmic" (see cosmic.toml.example).
# Omit for a headless machine.
desktop = "niri"

# Bootstrap Homebrew without declaring formulae, for ad-hoc use.
# A non-empty packages.brew implies this.
# brew = true

# Timezone and hostname are machine state: `timedatectl` and `hostnamectl`
# set them and they survive image updates. Pin them here only to force
# every machine built from this file to match. Unset, the hostname is
# "kuma" and `kuma vm` mirrors the host's timezone.
# timezone = "America/Denver"
# hostname = "kuma-laptop"

# Installs the matching glibc langpack and sets LANG.
# locale = "en_US.UTF-8"

# The primary account, created on first boot and converged on every boot
# after: shell, declared groups, and kuma-managed ssh keys.
[user]
name = "me"
shell = "fish"

# From `kuma passwd`. Applies only at creation, so change the password on
# the machine afterward and kuma won't fight you.
# password_hash = '$6$...'

# groups = ["wheel"]                  # the default
# ssh_keys = ["ssh-ed25519 AAAA..."]  # served to sshd from /etc/kuma/keys
# autologin = true                    # straight to the desktop, no greeter

[packages]
# Baked into the image: changing this list needs a rebuild and a reboot.
rpm = ["fish", "distrobox", "tailscale"]

# Flathub apps, converged on boot and daily: additions install, removals
# uninstall. `flatpak install --user` on the machine stays yours.
flatpak = [
    "org.mozilla.firefox",
    "org.gnome.Loupe",
    "org.gnome.Calculator",
    "io.github.celluloid_player.Celluloid",
    "org.gnome.Papers",
    "org.gnome.TextEditor",
    "org.libreoffice.LibreOffice",
]

# CLI tools that move faster than a rebuild-and-reboot cycle. Converged
# like flatpaks; ad-hoc `brew install` stays yours, and `kuma capture`
# offers to write it down here when you decide to keep it.
brew = ["ripgrep", "fd", "jq", "gh", "lazygit", "btop"]

# Your additions only. A desktop already enables what it needs (greeter,
# firewalld, bluetooth, cups, avahi for .local names and driverless
# printing, chronyd), so those don't belong here. Unit names are checked
# at build time, so a typo fails the build instead of being ignored.
[services]
enable = ["tailscaled.service"]
# disable = ["mdmonitor.service"]   # e.g. a service for hardware you don't have
