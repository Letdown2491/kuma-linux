# A Kuma system definition for the COSMIC desktop. See
# kuma.toml.example for every field the schema accepts.
schema_version = 1

[system]
base = "quay.io/fedora/fedora-bootc:44"

# System76's full desktop: panel, launcher, settings, files, terminal.
# It curates itself upstream, so kuma adds only hardware enablement and
# identity on top.
desktop = "cosmic"

# COSMIC's first-boot setup wizard never appears: the account and the
# defaults are declared here instead.
[user]
name = "me"
shell = "fish"
# password_hash = '$6$...'   # from `kuma passwd`
# autologin = true           # straight to the desktop at boot

[packages]
rpm = ["fish", "distrobox"]

# COSMIC's app store is deliberately not shipped: an app installed
# through a store would be removed again by the next convergence run.
# This list is the store, and `kuma add --flatpak <id>` is the install
# button.
flatpak = [
    "org.mozilla.firefox",
    "org.gnome.Loupe",
    "org.gnome.Papers",
]

# brew = ["ripgrep", "fd", "jq"]

# Your additions only. COSMIC already enables what it needs (greeter,
# firewalld, bluetooth, cups, avahi, chronyd), so those don't belong here.
[services]
enable = []
